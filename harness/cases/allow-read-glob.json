  "probes": [
    {"kind": "read", "path": "$ROOT/secrets/a.txt"},
    {"kind": "read", "path": "$ROOT/secrets/b.log"},
    {"kind": "read", "path": "$ROOT/secrets/sub/c.txt"}
  ]
}
