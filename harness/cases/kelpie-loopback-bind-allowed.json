{
  "files": {},
  "settings": {
    "network": {
      "allowedDomains": ["github.com", "api.github.com"],
      "deniedDomains": ["localhost", "127.0.0.1"],
      "strictAllowlist": true,
      "allowUnixSockets": ["$ROOT/scratch"],
      "allowLocalBinding": true
    },
    "filesystem": {
      "denyRead": ["~/.ssh/**"],
      "allowRead": [],
      "allowWrite": ["$ROOT/work"],
      "denyWrite": ["$ROOT/work/.env"]
    },
    "enableWeakerNetworkIsolation": true
  },
  "probes": [
    {"kind": "bind"},
    {"kind": "loopback"}
  ]
}
