{
  "files": {
    "$ROOT/secrets/key": "x",
    "$ROOT/secrets/deeper/key": "x",
    "$ROOT/open/readable": "x"
  },
  "settings": {
    "network": {"allowedDomains": [], "deniedDomains": []},
    "filesystem": {"denyRead": ["$ROOT/secrets"], "allowRead": [], "allowWrite": [], "denyWrite": []}
  },
  "probes": [
