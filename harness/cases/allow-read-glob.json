{
  "files": {
    "$ROOT/secrets/a.txt": "x",
    "$ROOT/secrets/b.log": "x",
    "$ROOT/secrets/sub/c.txt": "x"
  },
  "settings": {
    "network": {"allowedDomains": [], "deniedDomains": []},
    "filesystem": {"denyRead": ["$ROOT/secrets"], "allowRead": ["$ROOT/secrets/*.txt"], "allowWrite": [], "denyWrite": []}
