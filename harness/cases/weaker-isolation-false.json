{
  "files": {
    "$ROOT/readable": "x"
  },
  "settings": {
    "enableWeakerNetworkIsolation": false,
    "network": {"allowedDomains": [], "deniedDomains": []},
    "filesystem": {"denyRead": [], "allowRead": [], "allowWrite": [], "denyWrite": []}
  },
  "probes": [
    {"kind": "read", "path": "$ROOT/readable"},
    {"kind": "write", "path": "$ROOT/created"}
  ]
}
